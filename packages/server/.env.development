# The dev server's settings; the database is the one `npm run db` starts (compose.yaml).
DATABASE_URL=postgres://gymlog:gymlog@127.0.0.1:5433/gymlog
NODE_ENV=development
GYMLOG_TEST_SIGN_IN=1
# Where the app is opened in development, for the link the owner's Invite command prints.
APP_URL=http://localhost:5173
# VK ID sign-in: the app's ID from its registration with VK ID, and the callback address
# registered there. Without them, only the test sign-in works.
# VK_ID_CLIENT_ID=
# VK_ID_REDIRECT_URL=http://localhost:5173/api/vk/callback
