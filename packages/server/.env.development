# The dev server's settings; the database is the one `npm run db` starts (compose.yaml).
# The app connects as its own role, as in production; `npm run db` makes it and hands it the database.
DATABASE_URL=postgres://gymlog_app:gymlog@127.0.0.1:5433/gymlog
DATABASE_SUPERUSER_URL=postgres://gymlog:gymlog@127.0.0.1:5433/gymlog
APP_DATABASE_PASSWORD=gymlog
NODE_ENV=development
# Where the app is opened in development, for the links the owner's commands print.
APP_URL=http://localhost:5173
