# For `npm run db` only, which makes the app's role in the dev database (compose.yaml) and hands
# it the database; the dev server itself never gets the superuser's password, as in production.
DATABASE_SUPERUSER_URL=postgres://gymlog:gymlog@127.0.0.1:5433/gymlog
# The app's role's password; DATABASE_URL in .env.development uses it.
APP_DATABASE_PASSWORD=gymlog
