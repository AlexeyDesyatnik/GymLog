# The keys that read the backups (#16); they never go to the server. Copy to
# deploy/secrets/restore.env (git-ignored) and fill in from the password manager. Used by
# deploy/prod.sh backups and restore. See docs/deploy.md, Backups.

# Selectel's read key (service user gymlog-restore).
SELECTEL_ACCESS_KEY=
SELECTEL_SECRET_KEY=
# Yandex Object Storage's read key (service account gymlog-backup-read).
YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=
