# The server's backup settings (#16). Copy to deploy/secrets/backup.env (git-ignored), fill in from
# the password manager, and send with deploy/prod.sh backup-setup. See docs/deploy.md, Backups.

# Selectel's upload-only key (service user gymlog-backup).
SELECTEL_ACCESS_KEY=
SELECTEL_SECRET_KEY=
# Yandex Object Storage's upload key (service account gymlog-backup-upload).
YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=
# The mailbox notifications come from, its app password of type "Mail", and the owner's address.
MAIL_FROM=
MAIL_PASSWORD=
MAIL_TO=
